<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Act_Quick.FactListPage"
             Title="FactListPage">
	<CollectionView x:Name="FactCollectionView" ItemsSource="{Binding FactItems}">
		<CollectionView.ItemTemplate>
			<DataTemplate>
				<StackLayout Orientation="Horizontal">
					<CheckBox IsChecked="{Binding IsChecked}" CheckedChanged="OnCheckBoxCheckedChanged" />
					<Label Text="{Binding Fact}" Style="{StaticResource SubHeadline}">
						<Label.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnLabelTapped" />
						</Label.GestureRecognizers>
					</Label>
				</StackLayout>
			</DataTemplate>
		</CollectionView.ItemTemplate>
	</CollectionView>
</ContentPage>