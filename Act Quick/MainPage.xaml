<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Act_Quick.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="app_logo.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="Emergency kit with flashlight on cover" />

            <Label
                Text="Act Quick"
                Style="{StaticResource Headline}"/>

            <Label
                Text="Be prepared for emergencies!"
                Style="{StaticResource SubHeadline}"/>

            <Button
                x:Name="EmergencyBtn"
                Text="Emergencies List" 
                SemanticProperties.Hint="Tap to view a list of emergencies and preparedness actions to take"
                Clicked="ChangePageCommand"/>

            <Button
                x:Name="KitBtn"
                Text="Emergency Kit" 
                SemanticProperties.Hint="Tap to view essential items for an emergency kit"
                Clicked="ChangePageCommand"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
